# ==============================================================================
# Desktop Agent Workspace - Cross-Platform Environment Configuration
# ==============================================================================

# --- Primary LLM Provider: OpenRouter ---
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-sonnet-4
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Recommended OpenRouter models:
# - anthropic/claude-sonnet-4 (or claude-sonnet-4.5)
# - google/gemini-2.5-pro
# - deepseek/deepseek-chat
# - openai/gpt-4o

# --- Core Agent Provider (Goose) ---
GOOSE_PROVIDER=openrouter
GOOSE_MODEL=anthropic/claude-sonnet-4

# --- Browser Automation Configuration ---
# Set to 'false' to watch Chromium actions visibly on your desktop screen
# Set to 'true' for headless background automation
BROWSER_HEADLESS=false
BROWSER_USE_LOGGING_LEVEL=info

# --- Direct Provider Fallbacks (Optional) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
