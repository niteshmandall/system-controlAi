# ==============================================================================
# Desktop Agent Workspace - Cross-Platform Environment Configuration
# ==============================================================================

# --- Architecture Execution Mode ---
# hybrid = Cloud Orchestrator (OpenRouter) + Local Sub-Agent/Browser Worker (Ollama) [RECOMMENDED]
# local  = 100% Local Execution (Ollama on GTX 1650, zero cloud tokens)
# cloud  = 100% Cloud Execution (OpenRouter)
EXECUTION_MODE=hybrid

# --- Primary Cloud Orchestrator: OpenRouter ---
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-sonnet-4
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Recommended OpenRouter models:
# - anthropic/claude-sonnet-4 (or claude-sonnet-4.5)
# - google/gemini-2.5-pro
# - deepseek/deepseek-chat
# - openai/gpt-4o

# --- Core Agent Provider (Goose) ---
GOOSE_PROVIDER=openrouter
GOOSE_MODEL=anthropic/claude-sonnet-4

# --- Local Open Source LLM Option (Ollama / LM Studio) ---
# Set USE_LOCAL_LLM=true to run completely offline without cloud API keys
# Supported local models: qwen2.5-coder:14b, llama3.2-vision:11b, deepseek-r1:14b
USE_LOCAL_LLM=false
LOCAL_LLM_PROVIDER=ollama
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5-coder:7b
OLLAMA_HOST=http://localhost:11434

# --- Browser Automation Configuration ---
# Set to 'false' to watch Chromium actions visibly on your desktop screen
# Set to 'true' for headless background automation
BROWSER_HEADLESS=false
BROWSER_USE_LOGGING_LEVEL=info

# --- Real Google Chrome Profile & Remote Debugging (CDP) ---
# auto    = Connects to running Chrome on port 9222; falls back to persistent profile
# cdp     = Strictly connect to running Chrome via Remote Debugging (port 9222)
# profile = Launch real Chrome with persistent user data and specified profile
# sandbox = Launch clean ephemeral Chromium instance
CHROME_MODE=auto
CHROME_CDP_URL=http://localhost:9222
CHROME_PROFILE_DIRECTORY=Profile 9
CHROME_USER_DATA_DIR=C:\Users\nites\AppData\Local\Google\Chrome\User Data

# --- Direct Provider Fallbacks (Optional) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
